---
import Layout from '../../layouts/Layout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { committees, type Committee } from '../../data/committees';

export const prerender = true;

export function getStaticPaths() {
  return committees.map((committee, index) => ({
    params: { id: committee.id },
    props: {
      committee,
      prev: committees[(index - 1 + committees.length) % committees.length],
      next: committees[(index + 1) % committees.length],
    },
  }));
}

const { committee, prev, next } = Astro.props as { committee: Committee; prev: Committee; next: Committee };
const isRestricted = Boolean(committee.confidential);
const committeeTitle = isRestricted ? 'Committee X' : committee.name;
const overview = isRestricted
  ? 'The particulars of this committee will be disclosed at the appropriate time.'
  : committee.description;

const facts = isRestricted
  ? [{ label: 'Status', value: 'Classified' }]
  : [
      { label: 'Delegates', value: String(committee.size) },
      { label: 'Format', value: committee.format },
      { label: 'Category', value: committee.category },
    ];
---

<Layout title={`${committeeTitle} | Committees | OAKMUN BLR 26`}>
  <a class="skip-link" href="#committee-main">Skip to content</a>
  <div class="scroll-progress" aria-hidden="true"></div>

  <div class="catalogue committee-page">
    <div class="catalogue__field" aria-hidden="true"></div>

    <header class="nav nav--page" id="nav">
      <a class="nav__brand" href="/">
        <img src="/oakmun-mark.svg" alt="OAKMUN emblem" />
        <span>OAKMUN<br />BLR 26</span>
      </a>
      <nav class="nav__links" aria-label="Main navigation">
        <a href="/about-us">About Us</a>
        <a href="/committees">Committees</a>
        <a href="/#schedule">Schedule</a>
        <a href="/#resources">Resources</a>
        <a href="/#faq">FAQ</a>
      </nav>
      <div class="nav__end">
        <a class="nav__cta" href="/#register" data-magnetic="7">Register <span>↗</span></a>
        <button class="nav__toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="menu" aria-label="Open menu">
          <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
        </button>
      </div>
    </header>

    <div class="menu" id="menu" data-menu-panel hidden>
      <nav class="menu__links" aria-label="Main navigation">
        <a href="/about-us"><i class="u-index" aria-hidden="true">01</i>About Us</a>
        <a href="/committees"><i class="u-index" aria-hidden="true">02</i>Committees</a>
        <a href="/#schedule"><i class="u-index" aria-hidden="true">03</i>Schedule</a>
        <a href="/#resources"><i class="u-index" aria-hidden="true">04</i>Resources</a>
        <a href="/#faq"><i class="u-index" aria-hidden="true">05</i>FAQ</a>
      </nav>
      <a class="menu__cta btn btn--solid" href="/#register">Register <span>↗</span></a>
    </div>

    <main class="committee-detail" id="committee-main">
      <a class="committee-detail__back u-link" href="/committees"><span aria-hidden="true">←</span> All committees</a>

      <!-- HERO -->
      <section class="cm-hero" data-scrub="out">
        <div class="cm-hero__layers" aria-hidden="true">
          <img class="cm-hero__image" src={committee.image} alt="" />
          <span class="cm-hero__veil"></span>
          <span class="cm-hero__grid"></span>
          <span class="cm-hero__ghost">{String(committee.index).padStart(2, '0')}</span>
          <img class="cm-hero__emblem" src="/oakmun-mark.svg" alt="" data-parallax="0.2" />
        </div>
        <div class="cm-hero__copy">
          <p class="cm-hero__eyebrow" data-reveal="up">Committee {String(committee.index).padStart(2, '0')}</p>
          <h1 data-split data-reveal="fade">{committee.code}</h1>
          <p class="cm-hero__name" data-reveal="up" data-reveal-delay="180">{committeeTitle}</p>
        </div>
        <span class="cm-hero__cue" aria-hidden="true"></span>
      </section>

      <!-- FACTS -->
      {facts.length > 1 ? (
        <section
          class="cm-facts cm-facts--sequence"
          aria-label="Committee details"
          data-scrub="pin"
          style={`--count:${facts.length};`}
        >
          <div class="cm-facts__stage">
            {facts.map((fact, index) => (
              <div class:list={['cm-fact', { 'cm-fact--last': index === facts.length - 1 }]} style={`--i:${index};`}>
                <strong>{fact.value}</strong>
                <small>{fact.label}</small>
              </div>
            ))}
            <div class="cm-facts__ticks" aria-hidden="true">
              {facts.map((_, index) => <span style={`--i:${index};`}></span>)}
            </div>
          </div>
        </section>
      ) : (
        <section class="cm-facts" aria-label="Committee details">
          {facts.map((fact) => (
            <div class="cm-fact" data-reveal="up">
              <strong>{fact.value}</strong>
              <small>{fact.label}</small>
            </div>
          ))}
        </section>
      )}

      <!-- OVERVIEW -->
      <section class="cm-overview" id="overview">
        <div class="cm-overview__rail">
          <span class="u-index u-badge" data-reveal="up">01</span>
          <p data-reveal="up">Overview</p>
          <span class="cm-overview__mark" aria-hidden="true"></span>
        </div>
        <p class="cm-overview__body" data-scrub="cover" data-reveal="up">{overview}</p>
      </section>

      <!-- AGENDA -->
      <section class="cm-agenda" id="agenda" data-scrub="cover">
        <div class="cm-agenda__plate" aria-hidden="true">
          <img src={committee.image} alt="" loading="lazy" />
          <span class="cm-agenda__wash"></span>
        </div>
        <div class="cm-agenda__copy">
          <span class="u-index u-badge" data-reveal="up">02</span>
          <h2 data-split data-reveal="fade">Agenda</h2>
          <p class="cm-agenda__text" data-reveal="up" data-reveal-delay="160">
            {isRestricted ? 'Details will be disclosed at the appropriate time.' : committee.agenda}
          </p>
          <span class="cm-agenda__status" data-reveal="up" data-reveal-delay="240">Background guide · Coming soon</span>
        </div>
      </section>

      <!-- EXECUTIVE BOARD -->
      <section class="cm-board" aria-labelledby="eb-title">
        <div class="cm-board__head">
          <span class="u-index u-badge" data-reveal="up">03</span>
          <h2 id="eb-title" data-split data-reveal="fade">Executive Board</h2>
          <p data-reveal="up" data-reveal-delay="160">To be announced</p>
        </div>
        <div class="cm-board__grid" data-stagger>
          {['Chair', 'Vice-Chair', 'Director'].map((role) => (
            <article class="cm-seat" data-reveal="rise">
              <span class="cm-seat__frame" aria-hidden="true"><i class="skeleton"></i></span>
              <strong>To be announced</strong>
              <small>{role}</small>
            </article>
          ))}
        </div>
      </section>

      <!-- ADJACENT COMMITTEES -->
      <nav class="cm-jump" aria-label="Other committees">
        <a class="cm-jump__link cm-jump__link--prev" href={`/committees/${prev.id}`}>
          <small>Previous</small>
          <strong>{prev.confidential ? 'Committee X' : prev.code}</strong>
        </a>
        <a class="cm-jump__link cm-jump__link--next" href={`/committees/${next.id}`}>
          <small>Next</small>
          <strong>{next.confidential ? 'Committee X' : next.code}</strong>
        </a>
      </nav>
    </main>

    <SiteFooter backHref="/committees" backLabel="All committees" />
  </div>

  <script>
    import { initMotion } from '../../scripts/motion';
    import { initNav } from '../../scripts/nav';

    initNav(document.getElementById('nav'));
    initMotion(document);
    document.body.classList.add('intro-done');
  </script>
</Layout>

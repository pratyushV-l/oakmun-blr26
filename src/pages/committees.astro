---
import Layout from '../layouts/Layout.astro';
import { committees } from '../data/committees';
import SiteFooter from '../components/SiteFooter.astro';

const initials = (value: string) =>
  value
    .split(/[\s/,:-]+/)
    .filter((word) => /^[A-Z]/.test(word))
    .map((word) => word[0])
    .join('');

const searchTerms = (committee: (typeof committees)[number]) =>
  [
    committee.name,
    committee.code,
    committee.category,
    committee.format,
    committee.agenda,
    committee.shortAgenda,
    initials(committee.name),
    initials(committee.category),
  ]
    .filter(Boolean)
    .join(' ');
---

<Layout title="Committees | OAKMUN BLR 26">
  <a class="skip-link" href="#catalogue">Skip to content</a>
  <div class="scroll-progress" aria-hidden="true"></div>

  <div class="catalogue">
    <div class="catalogue__field" aria-hidden="true"></div>

    <header class="nav nav--page" id="nav">
      <a class="nav__brand" href="/">
        <img src="/oakmun-mark.svg" alt="OAKMUN emblem" />
        <span>OAKMUN<br />BLR 26</span>
      </a>
      <nav class="nav__links" aria-label="Main navigation">
        <a href="/about-us">About Us</a>
        <a href="/committees">Committees</a>
        <a href="/#schedule">Schedule</a>
        <a href="/#resources">Resources</a>
        <a href="/#faq">FAQ</a>
      </nav>
      <div class="nav__end">
        <a class="nav__cta" href="/#register" data-magnetic="7">Register <span>↗</span></a>
        <button class="nav__toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="menu" aria-label="Open menu">
          <span aria-hidden="true"></span><span aria-hidden="true"></span>
        </button>
      </div>
    </header>

    <div class="menu" id="menu" data-menu-panel hidden>
      <nav class="menu__links" aria-label="Main navigation">
        <a href="/about-us"><i class="u-index" aria-hidden="true">01</i>About Us</a>
        <a href="/committees"><i class="u-index" aria-hidden="true">02</i>Committees</a>
        <a href="/#schedule"><i class="u-index" aria-hidden="true">03</i>Schedule</a>
        <a href="/#resources"><i class="u-index" aria-hidden="true">04</i>Resources</a>
        <a href="/#faq"><i class="u-index" aria-hidden="true">05</i>FAQ</a>
      </nav>
      <a class="menu__cta btn btn--solid" href="/#register">Register <span>↗</span></a>
    </div>

    <main class="catalogue__main">
      <!-- HERO -->
      <section class="cat-hero">
        <img class="cat-hero__emblem" src="/oakmun-mark.svg" alt="" aria-hidden="true" data-parallax="0.2" />
        <p class="cat-hero__eyebrow" data-reveal="up">OAKMUN BLR 26 · BENGALURU, INDIA</p>
        <h1 class="cat-hero__title" data-split data-reveal="fade">Committees</h1>
      </section>

      <!-- FILTER BAR -->
      <section class="filters" aria-label="Filter committees">
        <div class="filters__inner">
          <span class="filters__label">Explore by</span>
          <div class="filters__tabs" role="group" aria-label="Filter by category">
            <button class="filters__tab is-active" type="button" data-filter="all">All</button>
            <button class="filters__tab" type="button" data-filter="General Assembly">General Assembly</button>
            <button class="filters__tab" type="button" data-filter="Specialized Committee">Specialized</button>
            <button class="filters__tab" type="button" data-filter="Semi-Crisis">Crisis</button>
            <span class="filters__marker" aria-hidden="true"></span>
          </div>
          <label class="filters__search">
            <span class="sr-only">Search committees</span>
            <input type="search" placeholder="Search committees" data-committee-search />
          </label>
        </div>
      </section>

      <!-- THE CATALOGUE -->
      <section class="catalogue__grid-shell" id="catalogue" aria-label="OAKMUN committees">
        <div class="cat-grid" data-stagger>
          {committees.map((committee) => (
            <button
              id={committee.id}
              class:list={['cat-card', { 'cat-card--classified': committee.confidential }]}
              type="button"
              data-committee-card
              data-reveal="rise"
              data-confidential={committee.confidential ? 'true' : 'false'}
              data-name={committee.name}
              data-category={committee.category}
              data-format={committee.format}
              data-size={committee.size}
              data-agenda={committee.agenda}
              data-image={committee.image}
              data-search={searchTerms(committee)}
            >
              <span class="cat-card__visual">
                <img src={committee.image} alt="" loading="lazy" />
                <span class="cat-card__no u-index">{String(committee.index).padStart(2, '0')}</span>
                <strong class:list={{ long: committee.code.length > 9 }}>
                  {committee.confidential ? 'CLASSIFIED' : committee.code}
                </strong>
                {!committee.confidential && <span class="cat-card__badge">View agenda</span>}
              </span>
              <span class="cat-card__copy">
                <h2>{committee.confidential ? 'Committee X' : committee.name}</h2>
                <p>{committee.confidential ? 'Details will be disclosed at the appropriate time.' : committee.shortAgenda}</p>
              </span>
            </button>
          ))}
        </div>
        <p class="cat-empty" data-committee-empty hidden>No committees match that search.</p>
      </section>
    </main>

    <!-- FOOTER -->
    <SiteFooter backHref="/" backLabel="Return home" />
  </div>

  <dialog class="sheet" aria-labelledby="dialog-title">
    <button class="sheet__close" type="button" aria-label="Close committee details"><span aria-hidden="true">×</span></button>
    <div class="sheet__media"><img class="sheet__image" src="" alt="" /></div>
    <div class="sheet__body">
      <p class="sheet__meta"></p>
      <h2 id="dialog-title"></h2>
      <hr class="u-rule" />
      <p class="sheet__agenda"></p>
      <span class="sheet__label"></span>
      <a class="sheet__guide" href="#" aria-disabled="true">Background guide <span>Coming soon</span></a>
    </div>
  </dialog>

  <script>
    import { initMotion } from '../scripts/motion';
    import { initNav } from '../scripts/nav';

    initNav(document.getElementById('nav'));
    initMotion(document);
    document.body.classList.add('intro-done');

    /* FILTERING */
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const search = document.querySelector<HTMLInputElement>('[data-committee-search]');
    const empty = document.querySelector<HTMLElement>('[data-committee-empty]');
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const marker = document.querySelector<HTMLElement>('.filters__marker');
    const cards = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-committee-card]'));
    let activeFilter = 'all';

    const moveMarker = (tab: HTMLElement) => {
      if (!marker) return;
      marker.style.width = `${tab.offsetWidth}px`;
      marker.style.transform = `translateX(${tab.offsetLeft}px)`;
    };

    const squash = (value: string) => value.replace(/[^a-z0-9]+/g, '');

    const matchesQuery = (haystack: string, term: string) => {
      if (!term) return true;
      const squashedTerm = squash(term);
      if (!squashedTerm) return true;
      const startsWithTerm = haystack
        .split(/\s+/)
        .some((token) => token.startsWith(term) || squash(token).startsWith(squashedTerm));
      if (term.length <= 2) return startsWithTerm;
      return startsWithTerm || haystack.includes(term) || squash(haystack).includes(squashedTerm);
    };

    const updateCards = () => {
      const term = search?.value.toLowerCase().trim() || '';
      let visible = 0;
      let shownIndex = 0;

      cards.forEach((card) => {
        const category = card.dataset.category || '';
        const matchesFilter = activeFilter === 'all' || category === activeFilter;
        const matchesSearch = matchesQuery((card.dataset.search || '').toLowerCase(), term);
        const show = matchesFilter && matchesSearch;

        if (show) {
          visible += 1;
          card.style.setProperty('--i', String(shownIndex));
          shownIndex += 1;
          if (card.hidden) {
            card.hidden = false;
            card.classList.add('is-out');
            void card.offsetWidth;
          }
          card.classList.remove('is-out');
        } else if (!card.hidden) {
          card.classList.add('is-out');
          if (reduce.matches) card.hidden = true;
          else window.setTimeout(() => { if (card.classList.contains('is-out')) card.hidden = true; }, 240);
        }
      });

      if (empty) empty.hidden = visible > 0;
    };

    search?.addEventListener('input', updateCards);
    tabs.forEach((tab) => tab.addEventListener('click', () => {
      activeFilter = tab.dataset.filter || 'all';
      tabs.forEach((item) => item.classList.toggle('is-active', item === tab));
      moveMarker(tab);
      updateCards();
    }));

    const activeTab = tabs.find((tab) => tab.classList.contains('is-active'));
    if (activeTab) requestAnimationFrame(() => moveMarker(activeTab));
    window.addEventListener('resize', () => {
      const current = tabs.find((tab) => tab.classList.contains('is-active'));
      if (current) moveMarker(current);
    });

    /* DETAIL SHEET */
    const dialog = document.querySelector<HTMLDialogElement>('.sheet');
    const closeButton = dialog?.querySelector<HTMLButtonElement>('.sheet__close');
    const image = dialog?.querySelector<HTMLImageElement>('.sheet__image');
    const title = dialog?.querySelector<HTMLHeadingElement>('#dialog-title');
    const meta = dialog?.querySelector<HTMLElement>('.sheet__meta');
    const agenda = dialog?.querySelector<HTMLElement>('.sheet__agenda');
    const label = dialog?.querySelector<HTMLElement>('.sheet__label');
    const guide = dialog?.querySelector<HTMLElement>('.sheet__guide');

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        if (!dialog || !image || !title || !meta || !agenda || !label || !guide) return;
        const rect = card.getBoundingClientRect();
        image.src = card.dataset.image || '';
        title.textContent = card.dataset.name || '';
        const classified = card.dataset.confidential === 'true';
        meta.textContent = classified
          ? 'CLASSIFIED COMMITTEE'
          : `${card.dataset.category} · ${card.dataset.format} · ${card.dataset.size} delegates`;
        agenda.textContent = classified
          ? 'This committee’s details remain undisclosed.'
          : card.dataset.agenda || '';
        label.textContent = classified
          ? 'OAKMUN BLR 26 · RESTRICTED ACCESS'
          : 'OAKMUN BLR 26 · FINAL AGENDA';
        guide.hidden = classified;
        dialog.showModal();

        // Grow the sheet out of the tile that opened it.
        const sheet = dialog.getBoundingClientRect();
        const clamp = (value: number, max: number) => Math.max(0, Math.min(max, value));
        dialog.style.transformOrigin =
          `${clamp(rect.left + rect.width / 2 - sheet.left, sheet.width)}px `
          + `${clamp(rect.top + rect.height / 2 - sheet.top, sheet.height)}px`;
        requestAnimationFrame(() => dialog.classList.add('is-open'));
      });
    });

    const close = () => {
      if (!dialog) return;
      dialog.classList.remove('is-open');
      if (reduce.matches) dialog.close();
      else window.setTimeout(() => dialog.close(), 240);
    };
    closeButton?.addEventListener('click', close);
    dialog?.addEventListener('click', (event) => { if (event.target === dialog) close(); });
    dialog?.addEventListener('cancel', (event) => { event.preventDefault(); close(); });
  </script>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import { committees } from '../data/committees';
import { letters } from '../data/secretariat';
import SiteFooter from '../components/SiteFooter.astro';
import { conference } from '../data/conference';
import { getCountdownParts } from '../scripts/countdown';

const countdown = getCountdownParts(Date.parse(conference.countdownTarget));
const countdownLabels = { days: 'DAYS', hours: 'HOURS', minutes: 'MINS', seconds: 'SECS' };

const deckImages = [
  '/gallery/delegates.jpg', '/gallery/flags-debate.jpg', '/gallery/moderator.jpg', '/gallery/flags-room.jpg',
  '/gallery/auditorium.jpg', '/gallery/delegates.jpg', '/gallery/flags-debate.jpg', '/gallery/flags-room.jpg',
  '/gallery/moderator.jpg', '/gallery/auditorium.jpg', '/gallery/delegates.jpg', '/gallery/flags-debate.jpg',
];

// Angles around the title ring, clockwise from 3 o'clock.
const deckPlacements = [
  { a: -58, r: 9,   band: 1 },
  { a: -30, r: -6,  band: 2 },
  { a: -4,  r: 5,   band: 1 },
  { a: 20,  r: 7,   band: 3 },
  { a: 46,  r: -9,  band: 2 },
  { a: 70,  r: 5,   band: 1 },
  { a: 110, r: -7,  band: 1 },
  { a: 136, r: 8,   band: 3 },
  { a: 162, r: -5,  band: 1 },
  { a: 190, r: 6,   band: 2 },
  { a: 218, r: -10, band: 3 },
  { a: 244, r: 4,   band: 1 },
].map((place) => ({
  ...place,
  ux: +Math.cos((place.a * Math.PI) / 180).toFixed(3),
  uy: +Math.sin((place.a * Math.PI) / 180).toFixed(3),
}));

const deckCards = committees
  .map((committee, index) => ({
    committee,
    image: deckImages[index],
    place: deckPlacements[index],
  }));

const introAssets = [
  '/oakmun-mark.svg', '/world-map.svg',
  '/intro/debate-room.jpg', '/intro/gavel.jpg', '/intro/placards.jpg',
  '/intro/delegates.jpg', '/intro/arrival.jpg',
  '/gallery/delegates.jpg', '/gallery/flags-debate.jpg', '/gallery/moderator.jpg',
  '/gallery/flags-room.jpg', '/gallery/auditorium.jpg',
];
---

<Layout title="OAKMUN BLR 26 | Ideas Too Bright To Be Silenced">
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="scroll-progress" aria-hidden="true"></div>

  <!-- TITLE SEQUENCE -->
  <div class="intro" id="intro" role="status" aria-label="Preparing OAKMUN 26" data-assets={introAssets.join(',')}>
    <div class="intro__montage" aria-hidden="true">
      <img class="intro__frame intro__frame--one" src="/intro/debate-room.jpg" alt="" />
      <img class="intro__frame intro__frame--two" src="/intro/gavel.jpg" alt="" />
      <img class="intro__frame intro__frame--three" src="/intro/placards.jpg" alt="" />
      <img class="intro__frame intro__frame--four" src="/intro/delegates.jpg" alt="" />
      <img class="intro__frame intro__frame--five" src="/intro/arrival.jpg" alt="" />
    </div>
    <div class="intro__geometry" aria-hidden="true">
      <span class="intro__line intro__line--top"></span>
      <span class="intro__line intro__line--right"></span>
      <span class="intro__ring"></span>
      <span class="intro__dot intro__dot--one"></span>
      <span class="intro__dot intro__dot--two"></span>
    </div>

    <img class="intro__mark" src="/oakmun-mark.svg" alt="OAKMUN emblem" />
    <p class="intro__edition">OAKMUN<br /><span>26</span></p>

    <div class="statement" aria-label="Ideas too bright to be silenced">
      <span class="statement__word word--ideas">IDEAS</span>
      <span class="statement__word word--too">TOO</span>
      <span class="statement__word word--bright">BRIGHT</span>
      <span class="statement__word word--to">TO</span>
      <span class="statement__word word--be">BE</span>
      <span class="statement__word word--silenced">SILENCED.</span>
    </div>

    <div class="loader" data-intro-progress>
      <img class="loader__mark" src="/oakmun-mark.svg" alt="" aria-hidden="true" />
      <div class="loader__label">LOADING</div>
      <div class="loader__track"><span class="loader__progress"></span></div>
    </div>
  </div>

  <!-- NAVIGATION -->
  <header class="nav" id="nav">
    <a class="nav__brand" href="#top">
      <img src="/oakmun-mark.svg" alt="OAKMUN emblem" />
      <span>OAKMUN<br />BLR 26</span>
    </a>
    <nav class="nav__links" aria-label="Main navigation">
      <a href="/about-us">About Us</a>
      <a href="/committees">Committees</a>
      <a href="#schedule">Schedule</a>
      <a href="#resources">Resources</a>
      <a href="#faq">FAQ</a>
    </nav>
    <div class="nav__end">
      <a class="nav__cta" href="#register" data-magnetic="7">Register <span>↗</span></a>
      <button class="nav__toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="menu" aria-label="Open menu">
        <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
      </button>
    </div>
  </header>

  <div class="menu" id="menu" data-menu-panel hidden>
    <nav class="menu__links" aria-label="Main navigation">
      <a href="/about-us"><i class="u-index" aria-hidden="true">01</i>About Us</a>
      <a href="/committees"><i class="u-index" aria-hidden="true">02</i>Committees</a>
      <a href="#schedule"><i class="u-index" aria-hidden="true">03</i>Schedule</a>
      <a href="#resources"><i class="u-index" aria-hidden="true">04</i>Resources</a>
      <a href="#faq"><i class="u-index" aria-hidden="true">05</i>FAQ</a>
    </nav>
    <a class="menu__cta btn btn--solid" href="#register">Register <span>↗</span></a>
  </div>

  <main class="site" id="main">
    <!-- HERO -->
    <div class="hero-runway" data-scrub="pin">
    <section class="hero" id="top" data-spotlight>
      <div class="hero__field" aria-hidden="true">
        <div class="hero__grid"></div>
        <img class="hero__atlas" src="/world-map.svg" alt="" />
        <span class="hero__watermark">26</span>
        <span class="hero__halo"></span>
        <canvas class="hero__depth" data-depth-field></canvas>
        <div class="spotlight"></div>
      </div>

      <div class="deck" aria-hidden="true">
        {deckCards.map(({ committee, image, place }, index) => (
          <div
            class={`deck__slot deck__slot--b${place.band}`}
            style={`--ux:${place.ux}; --uy:${place.uy}; --r:${place.r}deg; --i:${index};`}
          >
            <a
              class:list={['deck__card', { 'deck__card--classified': committee.confidential }]}
              href={`/committees/${committee.id}`}
              tabindex="-1"
            >
              <img class="deck__photo" src={committee.confidential ? committee.image : image} alt="" />
              <img class="deck__mark" src="/oakmun-mark.svg" alt="" />
              <span>{committee.confidential ? 'CLASSIFIED' : committee.category.toUpperCase()}</span>
              <strong>{committee.code}</strong>
              <em class="deck__more">View more <i aria-hidden="true">↗</i></em>
            </a>
          </div>
        ))}
      </div>

      <div class="hero__type">
        <img class="hero__emblem" src="/oakmun-mark.svg" alt="OAKMUN emblem" />
        <h1 class="hero__title">
          <span class="line"><span>OAKMUN</span></span>
          <span class="line line--accent"><span>BLR 26</span></span>
        </h1>
        <p class="hero__dates">{conference.dates.toUpperCase()}</p>
        <div class="countdown" data-countdown-target={conference.countdownTarget} role="timer" aria-live="off" aria-label="Countdown to December 17, 2026 at midnight IST">
          {Object.entries(countdownLabels).map(([unit, label], index) => (
            <>
              {index > 0 && <i aria-hidden="true">:</i>}
              <span><b class="u-index" data-countdown-unit={unit}>{String(countdown[unit as keyof typeof countdown]).padStart(2, '0')}</b>{label}</span>
            </>
          ))}
        </div>
      </div>


      <div class="hero__atlas-legend" aria-hidden="true">
        <p>🇮🇳&nbsp; 🇺🇳&nbsp; 🇿🇦&nbsp; 🇧🇷&nbsp; 🇯🇵&nbsp; 🇫🇷&nbsp; 🇩🇪&nbsp; 🇲🇽&nbsp; 🇰🇪&nbsp; 🇨🇦&nbsp; 🇰🇷&nbsp; 🇦🇺&nbsp; 🇪🇬&nbsp; 🇮🇩&nbsp; 🇦🇷&nbsp; 🇳🇬&nbsp; 🇹🇭&nbsp; 🇹🇷</p>
        <p>🇮🇳&nbsp; 🇺🇳&nbsp; 🇿🇦&nbsp; 🇧🇷&nbsp; 🇯🇵&nbsp; 🇫🇷&nbsp; 🇩🇪&nbsp; 🇲🇽&nbsp; 🇰🇪&nbsp; 🇨🇦&nbsp; 🇰🇷&nbsp; 🇦🇺&nbsp; 🇪🇬&nbsp; 🇮🇩&nbsp; 🇦🇷&nbsp; 🇳🇬&nbsp; 🇹🇭&nbsp; 🇹🇷</p>
      </div>
    </section>
    </div>

    <!-- 01 COMMITTEES -->
    <section class="chapter rail-section" id="committees" data-rail-section data-scrub="pin">
      <div class="rail-viewport" data-rail-viewport>
        <header class="masthead rail-masthead">
          <span class="u-index">01</span>
          <h2>COMMITTEES</h2>
          <p>SCROLL TO EXPLORE ALL 12</p>
        </header>

        <div class="rail" data-rail>
          {committees.map((committee) => (
            <a
              class:list={['plate', { 'plate--classified': committee.confidential }]}
              href={`/committees/${committee.id}`}
              aria-label={`View ${committee.name}`}
            >
              <div class="plate__media">
                <img src={committee.image} alt="" loading="lazy" />
                <span class="u-index">{String(committee.index).padStart(2, '0')}</span>
              </div>
              <p>{committee.name}</p>
              {committee.confidential ? (
                <>
                  <small>CLASSIFIED</small>
                  <h3>Details will be disclosed at the appropriate time.</h3>
                </>
              ) : (
                <>
                  <small>{committee.category} · {committee.format} · {committee.size}</small>
                  <h3>{committee.shortAgenda}</h3>
                </>
              )}
              <b>VIEW COMMITTEE <i aria-hidden="true">→</i></b>
            </a>
          ))}
        </div>

        <div class="rail__progress" aria-hidden="true"><span></span></div>
      </div>
    </section>

    <!-- 02 LETTERS FROM THE SECRETARIAT -->
    <section class="chapter secretariat" id="secretariat">
      <header class="masthead">
        <span class="u-index" data-reveal="up">02</span>
        <h2 data-split data-reveal="fade">LETTERS FROM THE SECRETARIAT</h2>
      </header>

      {letters.map((letter) => (
        <article class="letter" id={letter.id}>
          <div class="letter__aside">
            <figure class="letter__portrait" data-reveal="mask-up">
              <img src={letter.portrait} alt={`${letter.name}, ${letter.role}`} loading="lazy" width="1000" height="1500" />
              <figcaption>
                <strong>{letter.name}</strong>
                <small>{letter.signOff}</small>
              </figcaption>
            </figure>
          </div>

          <div class="letter__body">
            {letter.paragraphs.map((paragraph, paragraphIndex) => (
              <p data-reveal="up" data-reveal-delay={paragraphIndex * 90}>{paragraph}</p>
            ))}
          </div>
        </article>
      ))}

      <div class="letters-skip" data-letters-skip>
        <a href="#schedule" aria-label="Skip the letters and jump to the schedule">
          Skip <span aria-hidden="true">↓</span>
        </a>
      </div>
    </section>

    <!-- 03 SCHEDULE -->
    <section class="chapter schedule" id="schedule">
      <header class="masthead">
        <span class="u-index" data-reveal="up">03</span>
        <h2 data-split data-reveal="fade">SCHEDULE</h2>
        <p data-reveal="up" data-reveal-delay="200">{conference.dates.toUpperCase()} · Detailed timetable coming soon</p>
      </header>
      <div class="undecided" data-scrub="cover" data-reveal="mask-up">
        <div class="undecided__field" aria-hidden="true">
          <span class="undecided__grid"></span>
          <span class="undecided__glow"></span>
          <img class="undecided__emblem" src="/oakmun-mark.svg" alt="" data-parallax="0.22" />
        </div>
        <span class="undecided__ghost" aria-hidden="true">26</span>
        <strong class="undecided__word">COMING<br />SOON</strong>
      </div>
    </section>

    <!-- 04 RESOURCES -->
    <section class="chapter resources" id="resources">
      <header class="masthead">
        <span class="u-index" data-reveal="up">04</span>
        <h2 data-split data-reveal="fade">RESOURCES</h2>
      </header>
      <div class="dossier" data-stagger>
        <a class="dossier__tile dossier__tile--lead" href="#top" data-reveal="rise">
          <span class="u-index">01</span>
          <p>DELEGATE HANDBOOK</p>
          <b>COMING SOON</b>
          <i class="dossier__ghost" aria-hidden="true">01</i>
        </a>
        <a class="dossier__tile" href="#top" data-reveal="rise">
          <span class="u-index">02</span>
          <p>BACKGROUND GUIDES</p>
          <b>COMING SOON</b>
          <i class="dossier__ghost" aria-hidden="true">02</i>
        </a>
        <a class="dossier__tile" href="#top" data-reveal="rise">
          <span class="u-index">03</span>
          <p>CONFERENCE POLICIES</p>
          <b>COMING SOON</b>
          <i class="dossier__ghost" aria-hidden="true">03</i>
        </a>
      </div>
    </section>

    <!-- 03 UPDATES -->
    <section class="chapter updates" id="updates">
      <header class="masthead">
        <span class="u-index" data-reveal="up">03</span>
        <h2 data-split data-reveal="fade">UPDATES</h2>
      </header>
      <div class="standby" data-scrub="cover" data-reveal="up">
        <span class="standby__hatch" aria-hidden="true"></span>
        <span class="standby__sweep" aria-hidden="true"></span>
        <div class="standby__copy">
          <span class="standby__signal" aria-hidden="true"><i></i></span>
          <strong class="standby__line">Nothing for Now.</strong>
          <em class="standby__line standby__line--accent">Stay Tuned!</em>
        </div>
      </div>
    </section>

    <!-- 05 FAQ -->
    <section class="chapter faq" id="faq">
      <img class="faq__emblem" src="/oakmun-mark.svg" alt="" aria-hidden="true" data-parallax="0.14" />
      <header class="masthead">
        <span class="u-index" data-reveal="up">05</span>
        <h2 data-split data-reveal="fade">FAQ</h2>
      </header>
      <div class="faq__list" data-accordion data-stagger>
        <details data-reveal="up">
          <summary>When is OAKMUN BLR 26?<span aria-hidden="true">+</span></summary>
          <div data-accordion-panel><p>OAKMUN BLR 26 takes place on {conference.dates}. The detailed timetable will be announced soon.</p></div>
        </details>
        <details data-reveal="up">
          <summary>What is the registration deadline?<span aria-hidden="true">+</span></summary>
          <div data-accordion-panel><p>Registration closes two weeks before the conference date. Early registration is recommended as spots are limited.</p></div>
        </details>
        <details data-reveal="up">
          <summary>What should I bring to the conference?<span aria-hidden="true">+</span></summary>
          <div data-accordion-panel><p>Please bring formal business attire, notebooks, pens, and any research materials. All other conference materials will be provided.</p></div>
        </details>
        <details data-reveal="up">
          <summary>Is prior MUN experience required?<span aria-hidden="true">+</span></summary>
          <div data-accordion-panel><p>No prior experience is necessary. We welcome both novice and experienced delegates, with training sessions available for beginners.</p></div>
        </details>
        <details data-reveal="up">
          <summary>How are committee assignments made?<span aria-hidden="true">+</span></summary>
          <div data-accordion-panel><p>Committee assignments are based on your preferences indicated during registration, experience level, and availability in each committee.</p></div>
        </details>
      </div>
    </section>
  </main>

  <SiteFooter />

  <script>
    import { initMotion } from '../scripts/motion';
    import { initNav } from '../scripts/nav';
    import { initIntro } from '../scripts/intro';
    import { initCountdown } from '../scripts/countdown';
    import { initDepthField } from '../scripts/depthfield';

    initCountdown(document.querySelector<HTMLElement>('[data-countdown-target]'));
    const intro = document.getElementById('intro');
    initIntro(intro, intro?.dataset.assets?.split(',') ?? []);
    initNav(document.getElementById('nav'));
    initMotion(document);
    initDepthField(
      document.querySelector('[data-depth-field]'),
      document.getElementById('top'),
      document.querySelector('.hero-runway'),
    );

    // Cards only take clicks once they've landed.
    document.querySelector('.deck')?.addEventListener('animationend', (event) => {
      if ((event as AnimationEvent).animationName === 'deck-in') {
        (event.target as HTMLElement).classList.add('is-live');
      }
    });

    /* SKIP LETTERS */
    const skip = document.querySelector<HTMLElement>('[data-letters-skip]');
    const lettersSection = document.getElementById('secretariat');

    if (skip && lettersSection) {
      const syncSkip = () => {
        const rect = lettersSection.getBoundingClientRect();
        const shown = -rect.top > window.innerHeight * 0.35 && rect.bottom > window.innerHeight * 1.2;
        skip.classList.toggle('is-shown', shown);
      };
      syncSkip();
      window.addEventListener('scroll', syncSkip, { passive: true });
      window.addEventListener('resize', syncSkip);
    }
  </script>
</Layout>

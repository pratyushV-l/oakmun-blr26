---
import Layout from '../layouts/Layout.astro';
---

<Layout title="OAKMUN BLR 26 — Ideas Too Bright To Be Silenced">
  <main class="site-shell">
    <section class="intro" aria-label="OAKMUN BLR 26 introduction">
      <div class="intro-geometry" aria-hidden="true">
        <span class="geometry-line geometry-line--top"></span>
        <span class="geometry-line geometry-line--right"></span>
        <span class="geometry-ring"></span>
        <span class="geometry-dot geometry-dot--one"></span>
        <span class="geometry-dot geometry-dot--two"></span>
      </div>
      <img class="oakmun-mark" src="/oakmun-mark.svg" alt="OAKMUN emblem" />
      <p class="edition-mark">OAKMUN<br /><span>26</span></p>
      <div class="statement" aria-label="Ideas too bright to be silenced">
        <span class="statement__word word--ideas">IDEAS</span>
        <span class="statement__word word--too">TOO</span>
        <span class="statement__word word--bright">BRIGHT</span>
        <span class="statement__word word--to">TO</span>
        <span class="statement__word word--be">BE</span>
        <span class="statement__word word--silenced">SILENCED.</span>
      </div>
      <div class="loading-screen" role="status" aria-label="Preparing OAKMUN 26">
        <img class="loading-screen__mark" src="/oakmun-mark.svg" alt="" aria-hidden="true" />
        <div class="loading-screen__label">LOADING</div>
        <div class="loading-screen__track"><span class="loading-screen__progress"></span></div>
      </div>
      <section class="home-screen" aria-label="OAKMUN 2026 homepage">
        <header class="home-nav">
          <a class="home-brand" href="#top"><img src="/oakmun-mark.svg" alt="OAKMUN emblem" /><span>OAKMUN<br />BLR 26</span></a>
          <nav class="home-links" aria-label="Main navigation"><a href="#committees">Committees</a><a href="#schedule">Schedule</a><a href="#resources">Resources</a><a href="#faq">FAQ</a></nav>
          <a class="home-register" href="#register">Register <span>↗</span></a>
        </header>
        <main class="conference-hero" id="top">
          <div class="world-map" aria-hidden="true"><img src="/world-map.svg" alt="" />
            <p>🇮🇳&nbsp; 🇺🇳&nbsp; 🇿🇦&nbsp; 🇧🇷&nbsp; 🇯🇵&nbsp; 🇫🇷&nbsp; 🇩🇪&nbsp; 🇲🇽&nbsp; 🇰🇪&nbsp; 🇨🇦&nbsp; 🇰🇷&nbsp; 🇦🇺&nbsp; 🇪🇬&nbsp; 🇮🇩&nbsp; 🇦🇷&nbsp; 🇳🇬&nbsp; 🇹🇭&nbsp; 🇹🇷</p>
            <p>🇮🇳&nbsp; 🇺🇳&nbsp; 🇿🇦&nbsp; 🇧🇷&nbsp; 🇯🇵&nbsp; 🇫🇷&nbsp; 🇩🇪&nbsp; 🇲🇽&nbsp; 🇰🇪&nbsp; 🇨🇦&nbsp; 🇰🇷&nbsp; 🇦🇺&nbsp; 🇪🇬&nbsp; 🇮🇩&nbsp; 🇦🇷&nbsp; 🇳🇬&nbsp; 🇹🇭&nbsp; 🇹🇷</p>
          </div>
          <div class="committee-deck" aria-label="Committee image placeholders">
            <article class="deck-card deck-card--one"><img class="deck-card__photo" src="/gallery/delegates.jpg" alt="" /><img src="/oakmun-mark.svg" alt="" /><span>GENERAL ASSEMBLY</span><strong>SPECPOL</strong></article>
            <article class="deck-card deck-card--two"><img class="deck-card__photo" src="/gallery/flags-debate.jpg" alt="" /><img src="/oakmun-mark.svg" alt="" /><span>GENERAL ASSEMBLY</span><strong>UNGA</strong></article>
            <article class="deck-card deck-card--three"><img class="deck-card__photo" src="/gallery/moderator.jpg" alt="" /><img src="/oakmun-mark.svg" alt="" /><span>GENERAL ASSEMBLY</span><strong>UNHRC</strong></article>
            <article class="deck-card deck-card--four"><img class="deck-card__photo" src="/gallery/flags-room.jpg" alt="" /><img src="/oakmun-mark.svg" alt="" /><span>SEMI-CRISIS</span><strong>H-UNSC</strong></article>
            <article class="deck-card deck-card--five"><img class="deck-card__photo" src="/gallery/auditorium.jpg" alt="" /><img src="/oakmun-mark.svg" alt="" /><span>GENERAL ASSEMBLY</span><strong>DISEC</strong></article>
            <article class="deck-card deck-card--six"><img class="deck-card__photo" src="/gallery/delegates.jpg" alt="" /><img src="/oakmun-mark.svg" alt="" /><span>SPECIALIZED</span><strong>FATF</strong></article>
            <article class="deck-card deck-card--seven"><img class="deck-card__photo" src="/gallery/flags-debate.jpg" alt="" /><img src="/oakmun-mark.svg" alt="" /><span>SPECIALIZED</span><strong>INTERPOL</strong></article>
          </div>
          <aside class="conference-notices" aria-label="Conference updates">
            <a href="#register" class="conference-notice"><small>REGISTRATION</small><strong>Delegate applications</strong><b>→</b></a>
            <a href="#committees" class="conference-notice"><small>COMING SOON</small><strong>Committee catalogue</strong><b>→</b></a>
            <a href="#resources" class="conference-notice"><small>COMING SOON</small><strong>Conference resources</strong><b>→</b></a>
          </aside>
          <div class="conference-centre">
            <img class="conference-centre__mark" src="/oakmun-mark.svg" alt="OAKMUN emblem" />
            <p class="conference-centre__eyebrow">OAKMUN BLR 26 &nbsp;·&nbsp; BENGALURU, INDIA</p>
            <h1>OAKMUN<br /><span>BLR 26</span></h1>
            <p class="conference-centre__dates">DATES TO BE ANNOUNCED</p>
            <div class="conference-centre__actions"><a href="#register">Register <span>→</span></a><a href="#committees">Explore committees</a></div>
            <div class="countdown-placeholder"><span><b>--</b>DAYS</span><i>:</i><span><b>--</b>HOURS</span><i>:</i><span><b>--</b>MINS</span><i>:</i><span><b>--</b>SECS</span></div>
          </div>
          <div class="conference-visual" aria-hidden="true"><span class="conference-visual__line"></span><span class="conference-visual__ring"></span><span class="conference-visual__node"></span></div>
        </main>
        <section class="event-section event-section--committees reveal" id="committees">
          <div class="committee-sticky">
            <header class="section-head"><span>01</span><h2>COMMITTEES</h2><p>SCROLL TO EXPLORE ALL 12</p></header>
            <div class="committee-grid">
            <article class="committee-card"><div class="committee-card__media"><span>01</span>SPECPOL</div><p>SPECPOL</p><small>GENERAL ASSEMBLY · SINGLE DELEGATE · 40</small><h3>The Question of Western Sahara</h3></article>
            <article class="committee-card"><div class="committee-card__media"><span>02</span>UNGA</div><p>UNGA</p><small>GENERAL ASSEMBLY · SINGLE DELEGATE · 50</small><h3>The Principle of Self-Defence under Article 51 of the United Nations Charter</h3></article>
            <article class="committee-card"><div class="committee-card__media"><span>03</span>UNHRC</div><p>UNHRC</p><small>GENERAL ASSEMBLY · SINGLE DELEGATE · 50</small><h3>Agenda to be announced</h3></article>
            <article class="committee-card"><div class="committee-card__media"><span>04</span>H-UNSC</div><p>H-UNSC</p><small>SEMI-CRISIS · DOUBLE DELEGATE · 40</small><h3>The Yom Kippur War, 1973</h3></article>
            <article class="committee-card"><div class="committee-card__media"><span>05</span>DISEC</div><p>DISEC</p><small>GENERAL ASSEMBLY · SINGLE DELEGATE · 40</small><h3>The Regulation of Anti-Satellite Weapons</h3></article>
            <article class="committee-card"><div class="committee-card__media"><span>06</span>FATF</div><p>FATF</p><small>SPECIALIZED · SINGLE DELEGATE · 35</small><h3>Financial Crime Risks of Alternative Cross-Border Payment Systems</h3></article>
            <article class="committee-card"><div class="committee-card__media"><span>07</span>INTERPOL</div><p>INTERPOL</p><small>SPECIALIZED · SINGLE DELEGATE · 35</small><h3>Operation Shadow Storm</h3></article>
            <article class="committee-card"><div class="committee-card__media"><span>08</span>LOK SABHA</div><p>Lok Sabha</p><small>INDIAN PARLIAMENT · SINGLE DELEGATE · 35</small><h3>Reviewing the Implementation of the National Education Policy, 2020</h3></article>
            <article class="committee-card"><div class="committee-card__media"><span>09</span>IPC</div><p>IPC</p><small>PRESS · SINGLE DELEGATE · 20</small><h3>Press Freedom and the Protection of Journalists in Armed Conflict Zones</h3></article>
            <article class="committee-card"><div class="committee-card__media"><span>10</span>JCC</div><p>Alea Iacta Est</p><small>JCC · SINGLE DELEGATE · 40</small><h3>Caesar Crosses the Rubicon</h3></article>
            <article class="committee-card committee-card--confidential"><div class="committee-card__media"><span>11</span>COMMITTEE X</div><p>Committee X</p><small>CONFIDENTIAL</small><h3>Details to be disclosed</h3></article>
            <article class="committee-card"><div class="committee-card__media"><span>12</span>US SENATE</div><p>US Senate</p><small>REGIONAL LEGISLATURE · SINGLE DELEGATE · 25</small><h3>U.S. Policy toward Greenland</h3></article>
            </div>
          </div>
        </section>
        <section class="event-section event-section--experience reveal" id="experience">
          <div class="experience-media"><img src="/gallery/auditorium.jpg" alt="Delegates gathered for a previous OAKMUN conference" /><span>OAKMUN ARCHIVE</span><b>OAKMUN<br />BLR 26</b></div>
          <div class="experience-copy"><span>02</span><h2>THE<br />CONFERENCE</h2><p>PROGRAMME, SPEAKERS, AND CONFERENCE INFORMATION TO FOLLOW.</p></div>
        </section>
        <section class="event-section event-section--schedule reveal" id="schedule">
          <header class="section-head"><span>03</span><h2>SCHEDULE</h2><p>DATES TO BE ANNOUNCED</p></header>
          <div class="schedule-grid"><article><span>DAY 01</span><strong>OPENING</strong><p>DETAILS TO FOLLOW</p></article><article><span>DAY 02</span><strong>DEBATE</strong><p>DETAILS TO FOLLOW</p></article><article><span>DAY 03</span><strong>CLOSING</strong><p>DETAILS TO FOLLOW</p></article></div>
        </section>
        <section class="event-section event-section--resources reveal" id="resources">
          <header class="section-head"><span>04</span><h2>RESOURCES</h2></header>
          <div class="resource-list"><a href="#top"><span>01</span><p>DELEGATE HANDBOOK</p><b>COMING SOON</b></a><a href="#top"><span>02</span><p>BACKGROUND GUIDES</p><b>COMING SOON</b></a><a href="#top"><span>03</span><p>CONFERENCE POLICIES</p><b>COMING SOON</b></a></div>
        </section>
        <section class="event-section event-section--updates reveal" id="updates">
          <header class="section-head"><span>03</span><h2>UPDATES</h2></header>
          <div class="update-list"><a href="#register"><span>01</span><p>REGISTRATION</p><b>↗</b></a><a href="#committees"><span>02</span><p>COMMITTEES</p><b>↗</b></a><a href="#top"><span>03</span><p>OAKMUN BLR 26</p><b>↗</b></a></div>
        </section>
        <section class="event-section event-section--faq reveal" id="faq">
          <header class="section-head"><span>05</span><h2>FAQ</h2></header>
          <div class="faq-list"><details><summary>WHEN WILL REGISTRATION OPEN?<span>+</span></summary><p>DETAILS TO BE ANNOUNCED.</p></details><details><summary>WHEN WILL COMMITTEES BE RELEASED?<span>+</span></summary><p>DETAILS TO BE ANNOUNCED.</p></details><details><summary>WHERE WILL THE CONFERENCE BE HELD?<span>+</span></summary><p>BENGALURU, INDIA.</p></details></div>
        </section>
      </section>
    </section>
  </main>

  <script>
    window.setTimeout(() => {
      document.querySelector('.intro')?.classList.add('intro--loading');
    }, 4500);
    window.setTimeout(() => {
      document.querySelector('.intro')?.classList.add('intro--home');
    }, 8300);

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) entry.target.classList.add('is-visible');
      });
    }, { threshold: 0.14 });
    document.querySelectorAll('.reveal').forEach((section) => observer.observe(section));

    const home = document.querySelector('.home-screen');
    const committeeSection = document.querySelector('.event-section--committees');
    const committeeTrack = document.querySelector('.committee-grid');
    const committeeViewport = document.querySelector('.committee-sticky');
    const setCommitteeScrollRange = () => {
      if (!home || !committeeSection || !committeeTrack || !committeeViewport) return;
      const horizontalDistance = Math.max(0, committeeTrack.scrollWidth - committeeViewport.clientWidth);
      committeeSection.style.height = `${home.clientHeight + horizontalDistance}px`;
    };
    const syncCommitteeScroll = () => {
      if (!home || !committeeSection || !committeeTrack || !committeeViewport) return;
      const start = committeeSection.offsetTop;
      const range = Math.max(1, committeeSection.offsetHeight - home.clientHeight);
      const progress = Math.min(1, Math.max(0, (home.scrollTop - start) / range));
      const distance = Math.max(0, committeeTrack.scrollWidth - committeeViewport.clientWidth);
      committeeTrack.style.transform = `translateX(${-distance * progress}px)`;
    };
    requestAnimationFrame(() => { setCommitteeScrollRange(); syncCommitteeScroll(); });
    home?.addEventListener('scroll', syncCommitteeScroll, { passive: true });
    window.addEventListener('resize', () => { setCommitteeScrollRange(); syncCommitteeScroll(); });
  </script>
</Layout>
